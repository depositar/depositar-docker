# Host Ports
CKAN_PORT_HOST=5000
NGINX_PORT_HOST=80
NGINX_SSLPORT_HOST=8443

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore

# Test database connections
TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test

# Dev settings
USE_HTTPS_FOR_DEV=false

# CKAN core
CKAN_VERSION=2.10.0
CKAN_SITE_ID=default
CKAN_SITE_URL=https://demo.depositar.io
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=postfix:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_MAIL_FROM=no-reply@demo.depositar.io
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC

# Solr
SOLR_IMAGE_VERSION=2.9-solr8
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Redis
REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# Datapusher
DATAPUSHER_VERSION=0.0.20
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# NGINX
NGINX_PORT=80
NGINX_SSLPORT=443
CERTBOT_EMAIL=

# POSTFIX
POSTFIX_myhostname=postfix
ALLOWED_SENDER_DOMAINS=demo.depositar.io

# Extensions
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

## Spatial Settings
CKANEXT__SPATIAL__COMMON_MAP__TYPE = custom
CKANEXT__SPATIAL__COMMON_MAP__custom.url = //tile.openstreetmap.org/{z}/{x}/{y}.png
CKANEXT__SPATIAL__SEARCH_BACKEND = solr-spatial-field
CKANEXT__SPATIAL__COMMON_MAP__ATTRIBUTION = &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

## ckanext-data-depositario Settings
CKANEXT__DATA_DEPOSITARIO__GMAP__API_KEY =
CKANEXT__DATA_DEPOSITARIO__DEMO__ENABLED = true
CKANEXT__DATA_DEPOSITARIO__SITE_NOTICE = 下次清除時間 Next Purge:

## ckanext-citation settings
CKANEXT__CITATION__CSL_MAPPINGS = {"url": "erc_where"}

## ckanext-ark settings
CKANEXT__ARK__NAAN = 99999
CKANEXT__ARK__TEMPLATE = redededk
CKANEXT__ARK__ERC_MAPPINGS = {"who": "author", "what": "title", "when": ["start_time", "end_time"]}
CKANEXT__ARK__ALLOW_MISSING_ERC = False

# Geoview settings
CKANEXT__GEOVIEW__OL_VIEWER__FORMATS = wms wfs gml kml arcgis_rest gft
CKANEXT__GEOVIEW__SHP_VIEWER__SRID = 3826
CKANEXT__GEOVIEW__SHP_VIEWER__ENCODING = big5
